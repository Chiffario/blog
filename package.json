{
  "name": "sviffa",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "deploy-build": "vite build",
    "build": "wrangler types --check && vite build",
    "preview": "npm run build && wrangler pages dev",
    "prepare": "svelte-kit sync || echo ''",
    "check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "gen": "wrangler types",
    "deploy": "npm run deploy-build && wrangler pages deploy",
    "cf-typegen": "wrangler types src/worker-configuration.d.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.1.1",
    "mdsvex": "^1.0.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "wrangler": "^4.112.0"
  },
  "dependencies": {
    "layerchart": "^2.11.0",
    "toml": "^5.0.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
